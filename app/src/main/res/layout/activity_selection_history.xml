<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E2F6F7">

    <!--  Language Button -->
    <TextView
        android:id="@+id/btnLanguage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_lang"
        android:textSize="22sp"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"

        android:layout_marginTop="70dp"
        android:layout_marginEnd="24dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TITLE -->


    <!-- SUBTITLE -->


    <!-- CENTER PANEL -->

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="192dp"
        android:text="@string/history_title"
        android:textColor="@color/black"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnLanguage" />

    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/history_subtitle"
        android:textColor="#555555"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitle" />

    <LinearLayout
        android:id="@+id/layoutHistoryPanel"
        android:layout_width="384dp"
        android:layout_height="243dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/child_panel_background"
        android:orientation="vertical"

        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@id/txtSubtitle">


        <!-- Child Logs -->


        <!-- Tasks History -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnChildHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_child_button"
            android:drawableStart="@drawable/ic_history_24"
            android:drawablePadding="12dp"
            android:gravity="start|center_vertical"
            android:padding="20dp"
            android:text="@string/history_child"
            android:textAllCaps="false"
            android:textColor="#085F63"
            android:textSize="16sp"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTaskHistory"
            android:layout_width="351dp"
            android:layout_height="wrap_content"
            android:background="@drawable/card_child_button"
            android:drawableStart="@drawable/task_icsize"
            android:drawablePadding="12dp"
            android:gravity="start|center_vertical"
            android:padding="20dp"
            android:text="@string/history_tasks"
            android:textAllCaps="false"
            android:textColor="#085F63"
            android:textSize="16sp"
            app:backgroundTint="@null" />

    </LinearLayout>


    <!-- GO BACK -->
    <Button
        android:id="@+id/btnGoBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/go_back"
        android:textColor="@color/black"
        android:backgroundTint="#C7F0CF"
        android:paddingHorizontal="28dp"
        android:paddingVertical="10dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>