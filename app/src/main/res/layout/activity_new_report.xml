<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E2F6F7">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:id="@+id/btnLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_lang"
                android:textSize="22sp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="10dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="8dp"
                android:layout_gravity="end"/>
            <!-- Title -->
            <TextView
                android:id="@+id/txtTitleNewReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/new_report_title"
                android:textSize="26sp"
                android:layout_marginTop="28dp"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/txtSubtitleNewReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="@string/new_report_subtitle"
                android:textSize="15sp" />

            <!-- View history button (top-right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="end">


                <Button
                    android:id="@+id/btnViewHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_report_view_history"
                    android:textSize="12sp"
                    android:paddingHorizontal="28dp"
                    android:paddingVertical="10dp"
                    android:backgroundTint="#C7F0CF"
                    android:textColor="#2F6A43"
                    app:cornerRadius="24dp"
                    android:layout_marginBottom="20dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- Situation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_report_label_situation"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtSituation"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/new_report_hint_situation"
                    android:background="@drawable/white_card_pg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Date & Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_report_label_timestamp"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtDateTime"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/new_report_hint_timestamp"
                    android:background="@drawable/white_card_pg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_report_label_location"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtLocation"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/new_report_hint_location"
                    android:background="@drawable/white_card_pg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Child reaction -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_report_label_child_reaction"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtChildReaction"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/new_report_hint_child_reaction"
                    android:gravity="top|start"
                    android:background="@drawable/white_card_pg"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:inputType="textMultiLine" />
            </LinearLayout>

            <!-- How you handled it -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_report_label_how_handled"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtHowHandled"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/new_report_hint_how_handled"
                    android:gravity="top|start"
                    android:background="@drawable/white_card_pg"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:inputType="textMultiLine" />
            </LinearLayout>

            <!-- Questions for therapist -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_report_label_questions"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtQuestionsTherapist"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/new_report_hint_questions"
                    android:gravity="top|start"
                    android:background="@drawable/white_card_pg"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:inputType="textMultiLine" />
            </LinearLayout>

            <!-- Bottom buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnSendReport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_report_send"
                    android:textSize="14sp"
                    android:paddingHorizontal="28dp"
                    android:paddingVertical="10dp"
                    android:backgroundTint="#C7F0CF"
                    android:textColor="#2F6A43"
                    app:cornerRadius="24dp"
                    android:layout_marginBottom="20dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnGoBackReport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_report_go_back"
                    android:textSize="14sp"
                    android:paddingHorizontal="28dp"
                    android:paddingVertical="10dp"
                    android:backgroundTint="#C7F0CF"
                    android:textColor="#2F6A43"
                    app:cornerRadius="24dp"
                    android:layout_marginBottom="20dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>