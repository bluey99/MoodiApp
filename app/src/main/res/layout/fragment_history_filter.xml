<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_filter_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#085F63"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_filter_emotion"
        android:textStyle="bold"
        android:textColor="#4C5257"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupEmotions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:singleSelection="true"
        app:selectionRequired="false"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipHappy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96dp"
            android:minHeight="72dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="@string/step3_feeling_happy"
            android:textSize="14sp"
            android:textColor="#085F63"
            android:tag="HAPPY"
            android:contentDescription="@string/step3_feeling_happy"
            app:chipIcon="@drawable/emoji_happy"
            app:chipIconSize="36dp"
            app:chipIconVisible="true"
            app:iconStartPadding="8dp"
            app:textStartPadding="8dp"
            app:chipBackgroundColor="@color/chip_emotion_selector"
            app:checkedIconVisible="false"
            style="@style/Widget.MaterialComponents.Chip.Choice"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96dp"
            android:minHeight="72dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="@string/step3_feeling_sad"
            android:textSize="14sp"
            android:textColor="#085F63"
            android:tag="SAD"
            android:contentDescription="@string/step3_feeling_sad"
            app:chipIcon="@drawable/emoji_sad"
            app:chipIconSize="36dp"
            app:chipIconVisible="true"
            app:iconStartPadding="8dp"
            app:textStartPadding="8dp"
            app:chipBackgroundColor="@color/chip_emotion_selector"
            app:checkedIconVisible="false"
            style="@style/Widget.MaterialComponents.Chip.Choice"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAngry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96dp"
            android:minHeight="72dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="@string/step3_feeling_angry"
            android:textSize="14sp"
            android:textColor="#085F63"
            android:tag="ANGRY"
            android:contentDescription="@string/step3_feeling_angry"
            app:chipIcon="@drawable/emoji_angry"
            app:chipIconSize="36dp"
            app:chipIconVisible="true"
            app:iconStartPadding="8dp"
            app:textStartPadding="8dp"
            app:chipBackgroundColor="@color/chip_emotion_selector"
            app:checkedIconVisible="false"
            style="@style/Widget.MaterialComponents.Chip.Choice"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAfraid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96dp"
            android:minHeight="72dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="@string/step3_feeling_afraid"
            android:textSize="14sp"
            android:textColor="#085F63"
            android:tag="AFRAID"
            android:contentDescription="@string/step3_feeling_afraid"
            app:chipIcon="@drawable/emoji_afraid"
            app:chipIconSize="36dp"
            app:chipIconVisible="true"
            app:iconStartPadding="8dp"
            app:textStartPadding="8dp"
            app:chipBackgroundColor="@color/chip_emotion_selector"
            app:checkedIconVisible="false"
            style="@style/Widget.MaterialComponents.Chip.Choice"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSurprised"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="110dp"
            android:minHeight="72dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="@string/step3_feeling_surprised"
            android:textSize="14sp"
            android:textColor="#085F63"
            android:tag="SURPRISED"
            android:contentDescription="@string/step3_feeling_surprised"
            app:chipIcon="@drawable/emoji_surprised"
            app:chipIconSize="36dp"
            app:chipIconVisible="true"
            app:iconStartPadding="8dp"
            app:textStartPadding="8dp"
            app:chipBackgroundColor="@color/chip_emotion_selector"
            app:checkedIconVisible="false"
            style="@style/Widget.MaterialComponents.Chip.Choice"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDisgust"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="110dp"
            android:minHeight="72dp"
            android:text="@string/step3_feeling_disgust"
            android:textSize="14sp"
            android:textColor="#085F63"
            android:tag="DISGUST"
            app:chipIcon="@drawable/emoji_disgusted"
            app:chipIconSize="36dp"
            app:chipIconVisible="true"
            app:chipBackgroundColor="@color/chip_emotion_selector"
            app:checkedIconVisible="false"
            style="@style/Widget.MaterialComponents.Chip.Choice"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipUnsure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="110dp"
            android:minHeight="72dp"
            android:text="@string/step3_feeling_unsure"
            android:textSize="14sp"
            android:textColor="#085F63"
            android:tag="UNSURE"
            app:chipIcon="@drawable/emoji_unsure"
            app:chipIconSize="36dp"
            app:chipIconVisible="true"
            app:chipBackgroundColor="@color/chip_emotion_selector"
            app:checkedIconVisible="false"
            style="@style/Widget.MaterialComponents.Chip.Choice"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="110dp"
            android:minHeight="72dp"
            android:text="@string/step3_feeling_other"
            android:textSize="14sp"
            android:textColor="#085F63"
            android:tag="OTHER"
            app:chipBackgroundColor="@color/chip_emotion_selector"
            app:checkedIconVisible="false"
            style="@style/Widget.MaterialComponents.Chip.Choice"/>

    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_filter_intensity"
        android:textStyle="bold"
        android:textColor="#4C5257"
        android:layout_marginBottom="6dp"/>

    <FrameLayout
        android:id="@+id/glassContainer"
        android:layout_width="100dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:background="@drawable/intensity_glass_background"
        android:padding="8dp"
        android:clipToOutline="true">

        <FrameLayout
            android:id="@+id/fillContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:clipToOutline="true">

            <View
                android:id="@+id/fillView"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:background="@drawable/intensity_fill_level1" />
        </FrameLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/txtIntensityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_filter_any_intensity"
        android:textColor="#7A7A7A"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_filter_time"
        android:textStyle="bold"
        android:textColor="#4C5257"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="false"
        app:chipSpacingHorizontal="8dp"
        android:layout_marginBottom="24dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAllTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_filter_all_time"
            android:tag="ALL"
            style="@style/Widget.MaterialComponents.Chip.Choice"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLast7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_filter_last_7_days"
            android:tag="LAST_7_DAYS"
            style="@style/Widget.MaterialComponents.Chip.Choice"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLast30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_filter_last_30_days"
            android:tag="LAST_30_DAYS"
            style="@style/Widget.MaterialComponents.Chip.Choice"/>

    </com.google.android.material.chip.ChipGroup>

    <Button
        android:id="@+id/btnApplyFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/history_filter_apply"/>

    <Button
        android:id="@+id/btnClearFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/history_filter_clear"
        android:layout_marginTop="8dp"/>

</LinearLayout>