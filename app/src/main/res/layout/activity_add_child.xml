<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D7F1F1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginTop="60dp"
        android:gravity="center_horizontal">

        <!-- 🌐 language button (no background) -->
        <TextView
            android:id="@+id/btnLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_lang"
            android:textSize="22sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_gravity="end"
            android:padding="6dp"
            android:layout_marginBottom="10dp" />

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/addchild_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#4C5257"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/addchild_subtitle"
            android:textSize="14sp"
            android:textColor="#777777"
            android:layout_marginTop="4dp"/>

        <!-- CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_card_pg"
            android:layout_marginTop="30dp"
            android:padding="24dp"
            android:orientation="vertical"
            android:elevation="3dp">

            <!-- Parent Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/addchild_parent_info"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#4C5257"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/edtParentName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/addchild_hint_parent_name"
                android:background="@drawable/password_bg"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/edtParentId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/addchild_hint_parent_id"
                android:inputType="number"
                android:maxLength="9"
                android:background="@drawable/password_bg"
                android:padding="12dp"
                android:layout_marginBottom="20dp"/>

            <!-- Child Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/addchild_child_info"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#4C5257"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/edtChildName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/addchild_hint_child_name"
                android:background="@drawable/password_bg"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/edtChildId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/addchild_hint_child_id"
                android:inputType="number"
                android:maxLength="9"
                android:background="@drawable/password_bg"
                android:padding="12dp"
                android:layout_marginBottom="24dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddChild"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:text="@string/addchild_btn_add"
                android:textColor="#085F63"
                android:background="@drawable/btn_login_rounded"
                android:layout_gravity="center"/>

        </LinearLayout>

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancel"
            android:textSize="16sp"
            android:textColor="#4C5257"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</ScrollView>