<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E2F6F7"
    android:layoutDirection="locale"
    android:textDirection="locale">

    <TextView
        android:id="@+id/btnLanguage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_lang"
        android:textSize="20sp"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- Title -->
    <TextView
        android:id="@+id/tvEmotionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tasks_history_title"
        android:textSize="33sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@android:color/black"
        android:layout_marginTop="58dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvEmotionSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/emotion_history_subtitle"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="#506070"
        android:paddingHorizontal="24dp"
        android:paddingTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvEmotionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Filter button (same style as ChildLogs) -->
    <Button
        android:id="@+id/btnFilterBy"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/child_logs_filter_btn"
        android:textSize="14sp"
        android:paddingHorizontal="18dp"
        android:backgroundTint="#FFFFFF"
        android:textColor="#085F63"
        android:elevation="2dp"
        app:cornerRadius="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintTop_toBottomOf="@id/tvEmotionSubtitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEmotionHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="90dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/btnFilterBy"
        app:layout_constraintBottom_toTopOf="@id/btnGoBackEmotion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Go Back -->
    <Button
        android:id="@+id/btnGoBackEmotion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/go_back"
        android:textSize="14sp"
        android:paddingHorizontal="28dp"
        android:paddingVertical="10dp"
        android:backgroundTint="#C7F0CF"
        android:textColor="@android:color/black"
        app:cornerRadius="24dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>