<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F4F4">

    <include
        android:id="@+id/header"
        layout="@layout/view_child_history_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/child_panel_background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calming_tools_intro"
                    android:textSize="16sp"
                    android:textColor="#085F63"
                    android:layout_marginBottom="20dp" />

                <!-- BREATHING TOOL -->
                <LinearLayout
                    android:id="@+id/cardBreathing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/pill_button_selector">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calming_tools_breathing_title"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#085F63" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calming_tools_breathing_subtitle"
                        android:textSize="14sp"
                        android:textColor="#4C5257" />
                </LinearLayout>

                <!-- MUSIC TOOL -->
                <LinearLayout
                    android:id="@+id/cardMusic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/pill_button_selector">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calming_tools_music_title"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#085F63" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calming_tools_music_subtitle"
                        android:textSize="14sp"
                        android:textColor="#4C5257" />
                </LinearLayout>

                <!-- VISUAL TOOL -->
                <LinearLayout
                    android:id="@+id/cardVisual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/pill_button_selector">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calming_tools_visual_title"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#085F63" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calming_tools_visual_subtitle"
                        android:textSize="14sp"
                        android:textColor="#4C5257" />
                </LinearLayout>

                <!-- ASK FOR HELP TOOL -->
                <LinearLayout
                    android:id="@+id/cardAskForHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/pill_button_selector">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calming_tools_help_title"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#085F63" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calming_tools_help_subtitle"
                        android:textSize="14sp"
                        android:textColor="#4C5257" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/ic_heart"
                    android:tint="#68C4C5"
                    android:contentDescription="@string/calming_tools_heart_cd" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/calming_tools_encouragement"
                    android:textColor="#085F63"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>